@using FinanceManager.Web.Services
@inject IConfirmationService ConfirmationService
@inject Microsoft.Extensions.Localization.IStringLocalizer<Pages> Localizer

@if (Request != null)
{
    <div class="split-center" @onclick="OnBackdropClick">
        <div class="split-dialog confirm-dialog confirm-severity-@GetSeverityClass()" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
                <h2 id="confirm-title">@Localizer[Request.TitleResourceKey]</h2>
                <button class="icon-btn" title="@Localizer["Btn_Close"]" @onclick="OnCancel" aria-label="@Localizer["Btn_Close"]">
                    <svg><use href="/icons/sprite.svg#clear" /></svg>
                </button>
            </div>
            <p id="confirm-message">@Localizer[Request.MessageResourceKey]</p>
            <div class="confirm-dialog-actions" style="display:flex;justify-content:flex-end;gap:.5rem;margin-top:1rem;">
                <button class="btn secondary" @ref="_cancelButtonRef" @onclick="OnCancel">@Localizer["Btn_Cancel"]</button>
                <button class="btn btn-primary" @onclick="OnConfirm">@(Request.ConfirmButtonResourceKey is null ? Localizer["Btn_Confirm"] : Localizer[Request.ConfirmButtonResourceKey])</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ConfirmationRequest? Request { get; set; }

    private ElementReference _cancelButtonRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Request != null)
        {
            try
            {
                await _cancelButtonRef.FocusAsync();
            }
            catch
            {
                // Focus may fail during prerender or disconnect; safe default is to ignore.
            }
        }
    }

    private void OnConfirm() => ConfirmationService.SetResult(true);

    private void OnCancel() => ConfirmationService.Cancel();

    private void OnBackdropClick() => ConfirmationService.Cancel();

    private string GetSeverityClass() => (Request?.Severity ?? ConfirmationSeverity.Default).ToString().ToLowerInvariant();
}
