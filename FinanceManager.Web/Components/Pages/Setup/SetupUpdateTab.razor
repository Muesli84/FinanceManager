@using FinanceManager.Shared.Dtos.Update
@using FinanceManager.Web.ViewModels.Setup
@using FinanceManager.Web.Services
@implements IDisposable
@inject FinanceManager.Application.ICurrentUserService CurrentUser
@inject Microsoft.Extensions.Localization.IStringLocalizer<Pages> Localizer
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IConfirmationService ConfirmationService

@if (!CurrentUser.IsAuthenticated || !CurrentUser.IsAdmin)
{
    <p>@Localizer["Access_AdminOnly"]</p>
}
else
{
<div class="setup-tab setup-update-tab">
    <h4 style="margin-top:0;">@Localizer["SetupUpdate_Titel"]</h4>

    @if (!string.IsNullOrWhiteSpace(_vm?.LastError))
    {
        <div class="error" style="margin-top:.5rem;">@_vm!.LastError</div>
    }

    @if (_vm?.Settings is null || _vm.Status is null)
    {
        <div>@Localizer["Msg_Loading"]</div>
    }
    else if (_vm.Installing)
    {
        <div class="info" style="margin-bottom:.75rem;">@Localizer[_vm.InstallPhase ?? "Msg_Update_Installing"]</div>
    }
    else
    {
        <div class="setup-form-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:.75rem;">
            <label>
                <input type="checkbox" data-testid="update-enabled-checkbox" checked="@_vm.Settings.Enabled" @onchange="OnEnabledChanged" />
                @Localizer["SetupUpdate_Lbl_Enabled"]
            </label>
            <label>
                <input id="setup-update-include-prereleases" type="checkbox" checked="@_vm.Settings.IncludePrereleases" @onchange="OnIncludePrereleasesChanged" />
                @Localizer["SetupUpdate_Lbl_IncludePrereleases"]
            </label>
            <label>
                @Localizer["SetupUpdate_Lbl_SourceCheckStartTime"]
                <input id="setup-update-source-check-start-time" class="form-control" type="time" value="@FormatTime(_vm.Settings.SourceCheckStartTime)" @onchange="OnSourceCheckStartChanged" />
            </label>
            <label>
                @Localizer["SetupUpdate_Lbl_SourceCheckEndTime"]
                <input id="setup-update-source-check-end-time" class="form-control" type="time" value="@FormatTime(_vm.Settings.SourceCheckEndTime)" @onchange="OnSourceCheckEndChanged" />
            </label>
            <label>
                @Localizer["SetupUpdate_Lbl_ScheduledTime"]
                <input id="setup-update-scheduled-time" class="form-control" type="time" value="@FormatTime(_vm.Settings.ScheduledInstallTime)" @onchange="OnScheduleChanged" />
            </label>
            <label>
                @Localizer["SetupUpdate_Lbl_ServiceName"]
                <input id="setup-update-service-name" class="form-control" list="update-service-suggestions" value="@_vm.Settings.ServiceName" @oninput="OnServiceNameInputAsync" @onchange="OnServiceNameChanged" @onfocus="LoadServiceSuggestionsAsync" />
                <datalist id="update-service-suggestions">
                    @foreach (var serviceName in _vm.ServiceSuggestions)
                    {
                        <option value="@serviceName"></option>
                    }
                </datalist>
            </label>
        </div>

        <dl style="display:grid;grid-template-columns:max-content 1fr;gap:.35rem .75rem;margin-top:1rem;">
            <dt>@Localizer["SetupUpdate_Dl_Status"]</dt><dd data-testid="update-status-value">@Localizer[UpdateStatusKey(_vm.Status.Status)]</dd>
            <dt>@Localizer["SetupUpdate_Dl_Installed"]</dt><dd>@(_vm.Status.InstalledVersion ?? Localizer["SetupUpdate_Val_Unknown"].Value)</dd>
            <dt>@Localizer["SetupUpdate_Dl_Platform"]</dt><dd>@_vm.Status.CurrentPlatform</dd>
            <dt>@Localizer["SetupUpdate_Dl_LastChecked"]</dt><dd>@FormatDate(_vm.Status.LastCheckedAt)</dd>
            <dt>@Localizer["SetupUpdate_Dl_Available"]</dt><dd data-testid="update-available-value">@(_vm.Status.AvailableVersion ?? "-")</dd>
            <dt>@Localizer["SetupUpdate_Dl_Package"]</dt><dd>@(_vm.Status.DownloadedAssetName ?? "-")</dd>
            <dt>@Localizer["SetupUpdate_Dl_Lock"]</dt><dd>@(_vm.Status.IsLocked ? string.Format(Localizer["SetupUpdate_Val_LockActiveSince"].Value, FormatDate(_vm.Status.LockCreatedAt)) : "-")</dd>
        </dl>

        @if (_vm.Status.AvailableUpdate is not null)
        {
            <div style="margin-top:1rem;">
                <h5>@string.Format(Localizer["SetupUpdate_ReleaseHeading"].Value, _vm.Status.AvailableUpdate.Version)</h5>
                <div class="table-responsive">
                    <table class="fm-table">
                        <thead>
                            <tr>
                                <th>@Localizer["SetupUpdate_Th_Platform"]</th>
                                <th>@Localizer["SetupUpdate_Th_Runtime"]</th>
                                <th>@Localizer["SetupUpdate_Th_File"]</th>
                                <th>@Localizer["SetupUpdate_Th_Size"]</th>
                                <th>@Localizer["SetupUpdate_Th_Sha256"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in _vm.Status.AvailableUpdate.Assets)
                            {
                                <tr>
                                    <td>@asset.Platform</td>
                                    <td>@asset.RuntimeIdentifier</td>
                                    <td>@asset.AssetName</td>
                                    <td>@FormatBytes(asset.SizeBytes)</td>
                                    <td style="font-family:monospace;word-break:break-all;">@asset.Sha256</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p style="white-space:pre-wrap;">@_vm.Status.AvailableUpdate.ReleaseNotes</p>
            </div>
        }
    }
</div>
}

@code {
    [Parameter] public SetupUpdateViewModel? ViewModel { get; set; }

    private SetupUpdateViewModel? _vm;
    private EventHandler? _stateChangedHandler;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollingCts;

    protected override async Task OnInitializedAsync()
    {
        _vm = ViewModel ?? throw new InvalidOperationException("ViewModel parameter is required for SetupUpdateTab.");
        _stateChangedHandler = (_, __) => _ = InvokeAsync(StateHasChanged);
        _vm.StateChanged += _stateChangedHandler;
        _vm.ConfirmInstallAsync = ConfirmInstallAsync;
        _vm.InstallStarted += OnInstallStarted;
        await _vm.LoadAsync();
    }

    public void Dispose()
    {
        if (_vm is not null && _stateChangedHandler is not null)
        {
            _vm.StateChanged -= _stateChangedHandler;
        }
        if (_vm is not null)
        {
            _vm.ConfirmInstallAsync = null;
            _vm.InstallStarted -= OnInstallStarted;
        }
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
        _timer?.Dispose();
    }

    private ValueTask<bool> ConfirmInstallAsync()
        => new ValueTask<bool>(ConfirmationService.ConfirmAsync(new(
            TitleResourceKey: "Confirmation_Finalize_Title",
            MessageResourceKey: "Msg_Update_ConfirmDowntime",
            Severity: ConfirmationSeverity.Warning)));

    private void OnInstallStarted(object? sender, EventArgs args)
        => _ = InvokeAsync(PollHealthAsync);

    private async Task PollHealthAsync()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
        _pollingCts = new CancellationTokenSource(TimeSpan.FromSeconds(_vm!.Settings?.HealthTimeoutSeconds ?? 120));
        _timer?.Dispose();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        using var http = HttpClientFactory.CreateClient();
        http.BaseAddress = new Uri(Navigation.BaseUri);
        var outageObserved = false;
        _vm.SetInstallPhase("Msg_Update_Installing");

        void MarkOutage()
        {
            outageObserved = true;
            _vm.SetInstallPhase("Msg_Update_WaitingForRestart");
        }

        try
        {
            while (await _timer.WaitForNextTickAsync(_pollingCts.Token))
            {
                try
                {
                    var response = await http.GetAsync("health", _pollingCts.Token);
                    if (ShouldReloadAfterHealth(outageObserved, response.IsSuccessStatusCode))
                    {
                        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
                        return;
                    }

                    if (!response.IsSuccessStatusCode)
                    {
                        MarkOutage();
                    }
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    MarkOutage();
                }
            }
        }
        catch (OperationCanceledException)
        {
            _vm!.MarkHealthTimeout();
        }
    }

    private void OnEnabledChanged(ChangeEventArgs e) => Update(s => s with { Enabled = e.Value is bool b && b });
    private void OnIncludePrereleasesChanged(ChangeEventArgs e) => Update(s => s with { IncludePrereleases = e.Value is bool b && b });
    private void OnSourceCheckStartChanged(ChangeEventArgs e) => Update(s => s with { SourceCheckStartTime = TimeOnly.TryParse(Convert.ToString(e.Value), out var t) ? t : s.SourceCheckStartTime });
    private void OnSourceCheckEndChanged(ChangeEventArgs e) => Update(s => s with { SourceCheckEndTime = TimeOnly.TryParse(Convert.ToString(e.Value), out var t) ? t : s.SourceCheckEndTime });
    private void OnScheduleChanged(ChangeEventArgs e) => Update(s => s with { ScheduledInstallTime = TimeOnly.TryParse(Convert.ToString(e.Value), out var t) ? t : null });
    private void OnServiceNameChanged(ChangeEventArgs e) => Update(s => s with { ServiceName = Convert.ToString(e.Value) });

    private async Task OnServiceNameInputAsync(ChangeEventArgs e)
    {
        OnServiceNameChanged(e);
        await LoadServiceSuggestionsAsync();
    }

    private Task LoadServiceSuggestionsAsync()
        => _vm?.LoadServiceSuggestionsAsync(_vm.Settings?.ServiceName) ?? Task.CompletedTask;

    private void Update(Func<UpdateSettingsDto, UpdateSettingsDto> update)
    {
        if (_vm?.Settings is not null)
        {
            _vm.UpdateSettings(update(_vm.Settings));
        }
    }

    private static string FormatTime(TimeOnly time) => time.ToString("HH:mm");
    private static string FormatTime(TimeOnly? time) => time?.ToString("HH:mm") ?? string.Empty;
    private static string FormatDate(DateTimeOffset? date) => date?.ToLocalTime().ToString("g") ?? "-";
    private static string FormatBytes(long bytes) => bytes <= 0 ? "-" : $"{bytes / 1024d / 1024d:0.##} MB";
    private static string UpdateStatusKey(UpdateStatusKind status) => $"UpdateStatusKind_{status}";
    public static bool ShouldReloadAfterHealth(bool outageObserved, bool healthSuccessful) => outageObserved && healthSuccessful;
}
