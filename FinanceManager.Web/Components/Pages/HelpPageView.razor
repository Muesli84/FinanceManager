@page "/help/view/{*HelpPath}"
@layout HelpLayout
@using System.Globalization
@using FinanceManager.Web.Services.Help
@inject IHelpContentRenderer HelpContentRenderer
@inject IHelpAssetIntegrityValidator HelpAssetIntegrityValidator
@inject IWebHostEnvironment Environment

@{
    var lang = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "en" : "de";
}

@if (isLoading)
{
    <div class="help-shell">
        <div class="alert alert-info help-state">
            <span class="spinner-border spinner-border-sm me-2"></span>
            @(lang == "en" ? "Loading help content..." : "Hilfeinhalt wird geladen...")
        </div>
    </div>
}
else if (error != null)
{
    <div class="help-shell">
        <div class="help-error-panel">
            <h1>@(lang == "en" ? "Help page not available" : "Hilfeseite nicht verfuegbar")</h1>
            <p>@error</p>
            <a class="btn btn-primary" href="/help">@(lang == "en" ? "Back to help overview" : "Zur Hilfeuebersicht")</a>
        </div>
    </div>
}
else if (markdown != null && topic != null && currentDocument != null)
{
    <div class="help-shell help-detail-shell">
        <nav class="help-breadcrumb" aria-label="@(lang == "en" ? "Help navigation" : "Hilfe-Navigation")">
            <a href="/help">@(lang == "en" ? "Help overview" : "Hilfeuebersicht")</a>
            <span aria-hidden="true">/</span>
            <span>@topic.Title</span>
        </nav>

        <div class="help-detail-layout">
            <aside class="help-detail-nav" aria-label="@(lang == "en" ? "Topic pages" : "Themenseiten")">
                <h2>@topic.Title</h2>
                <p>@topic.Description</p>
                @if (topic.Documents.Count > 1)
                {
                    <div class="help-detail-links">
                        @foreach (var document in topic.Documents)
                        {
                            var route = document.RouteSegment.Equals(topic.PrimaryDocument.RouteSegment, StringComparison.OrdinalIgnoreCase)
                                ? topic.Id
                                : $"{topic.Id}/{document.RouteSegment}";
                            <a class="@(document.RouteSegment.Equals(currentDocument.RouteSegment, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                               href="@($"/help/view/{route}")">
                                @document.Title
                            </a>
                        }
                    </div>
                }
            </aside>

            <article class="help-view-content">
                @((MarkupString)markdown)
            </article>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? HelpPath { get; set; }

    private string? markdown;
    private string? error;
    private bool isLoading = true;
    private HelpTopic? topic;
    private HelpTopicDocument? currentDocument;
    private string language = "de";

    protected override async Task OnInitializedAsync()
    {
        language = CultureInfo.CurrentUICulture.Name.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "en" : "de";

        if (string.IsNullOrWhiteSpace(HelpPath))
        {
            error = language == "en"
                ? "Please choose a topic from the help overview."
                : "Bitte waehlen Sie ein Thema aus der Hilfeuebersicht.";
            isLoading = false;
            return;
        }

        try
        {
            if (!HelpDocumentPathResolver.TryNormalizeHelpPath(HelpPath, out var normalizedHelpPath))
            {
                error = language == "en"
                    ? "This help page is not part of the published user help."
                    : "Diese Hilfeseite gehoert nicht zur freigegebenen Anwenderhilfe.";
                return;
            }

            var docsPath = HelpDocumentPathResolver.GetHelpSourcePath(Environment);
            var selectedFile = HelpDocumentPathResolver.FindMarkdownFile(docsPath, language, normalizedHelpPath);
            if (selectedFile is null
                || !HelpContentCatalog.TryResolveDocument(docsPath, language, normalizedHelpPath, out var resolvedTopic, out var resolvedDocument, out _)
                || !HelpAssetIntegrityValidator.IsTrustedHelpFile(selectedFile))
            {
                error = language == "en"
                    ? "The requested content is not published in the user help."
                    : "Der angeforderte Inhalt ist nicht in der Anwenderhilfe veroeffentlicht.";
                return;
            }

            topic = resolvedTopic;
            currentDocument = resolvedDocument;

            var content = await File.ReadAllTextAsync(selectedFile, System.Text.Encoding.UTF8);
            var relativeDocumentPath = Path.GetRelativePath(docsPath, selectedFile).Replace('\\', '/');
            markdown = HelpContentRenderer.RenderMarkdownToHtml(content, relativeDocumentPath);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading help page: {ex.Message}");
            error = language == "en"
                ? "The help content could not be loaded."
                : "Der Hilfeinhalt konnte nicht geladen werden.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
