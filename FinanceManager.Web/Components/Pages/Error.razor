@page "/Error"
@using System.Diagnostics
@inject Microsoft.Extensions.Localization.IStringLocalizer<Pages> Localizer

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">@Localizer["Error_Heading"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["Error_DevMode_Heading"]</h3>
<p>
    @Localizer["Error_DevMode_Info"]
</p>
<p>
    <strong>@Localizer["Error_DevMode_Warning"]</strong>
    @Localizer["Error_DevMode_Details"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
