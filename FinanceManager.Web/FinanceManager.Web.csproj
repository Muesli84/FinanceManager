<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="Services\Help\HelpLanguages.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>FinanceManager.Web.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="updates\settings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="updates\status.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="wwwroot\css\app.SetupNotificationsTab.css" />
    <Content Update="Data\KnownContacts.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Docs\help\**\*" Link="Docs\help\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\help\**\*.*" />
    <Content Include="wwwroot\help\css\**\*.css;wwwroot\help\js\**\*.js;wwwroot\help\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="updates\settings.json" />
    <Content Remove="updates\status.json" />
    <Content Remove="wwwroot\help\de\f004b.html" />
    <Content Remove="wwwroot\help\en\f004b.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinanceManager.Application\FinanceManager.Application.csproj" />
    <ProjectReference Include="..\FinanceManager.Infrastructure\FinanceManager.Infrastructure.csproj" />
    <ProjectReference Include="..\FinanceManager.Domain\FinanceManager.Domain.csproj" />
    <ProjectReference Include="..\FinanceManager.Shared\FinanceManager.Shared.csproj" />
    <ProjectReference Include="..\tools\FinanceManager.HelpSearchIndexGenerator\FinanceManager.HelpSearchIndexGenerator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS1591;</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS1591;</WarningsAsErrors>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageReference Include="msTools.Updater" Version="0.10.1" />
    <PackageReference Include="msTools.Web.Blazor" Version="1.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="updates\settings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="updates\status.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\help\de\f001.html">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyInitFiles" BeforeTargets="Build">
	  <RemoveDir Directories="$(ProjectDir)init" Condition="Exists('$(ProjectDir)init')" />
	  <RemoveDir Directories="$(TargetDir)init" Condition="Exists('$(TargetDir)init')" />
  </Target>

  <Target Name="GenerateHelpLanguagesSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_GeneratedHelpLanguagesPath>$(IntermediateOutputPath)HelpLanguages.g.cs</_GeneratedHelpLanguagesPath>
      <_EscapedHelpSupportedLanguages>$([MSBuild]::Escape('$(HelpSupportedLanguages)'))</_EscapedHelpSupportedLanguages>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(_GeneratedHelpLanguagesPath)" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(_GeneratedHelpLanguagesPath)"
      Lines="namespace FinanceManager.Web.Services.Help%3B public static partial class HelpLanguages { private const string GeneratedDefaultLanguage = &quot;$(HelpDefaultLanguage)&quot;%3B private const string SupportedLanguageCodes = &quot;$(_EscapedHelpSupportedLanguages)&quot;%3B }"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <Target Name="GenerateHelpSearchIndexes" BeforeTargets="ResolveProjectStaticWebAssets;ComputeFilesToPublish;GenerateHelpAssetManifest">
    <Message Importance="High" Text="Generating help search indexes for $(HelpSupportedLanguages)" />
    <Exec Command="dotnet run --no-restore --project &quot;$(MSBuildProjectDirectory)\..\tools\FinanceManager.HelpSearchIndexGenerator\FinanceManager.HelpSearchIndexGenerator.csproj&quot; --no-launch-profile -- &quot;$(MSBuildProjectDirectory)\..\Docs\help&quot; &quot;$(TargetDir)wwwroot\help&quot; &quot;$(HelpSupportedLanguages)&quot; &quot;$(MSBuildProjectDirectory)\wwwroot\help&quot;" />
  </Target>

  <Target Name="GenerateHelpAssetManifest" DependsOnTargets="GenerateHelpSearchIndexes" AfterTargets="Build">
  </Target>

  <Target Name="IncludeGeneratedHelpAssetsInPublish" DependsOnTargets="GenerateHelpSearchIndexes" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_GeneratedHelpPublishAsset Include="$(TargetDir)wwwroot\help\**\*.json" />
      <_GeneratedHelpPublishAsset Include="$(TargetDir)wwwroot\help\help-assets.sha256" />
      <ResolvedFileToPublish Include="@(_GeneratedHelpPublishAsset)">
        <RelativePath>wwwroot\help\%(_GeneratedHelpPublishAsset.RecursiveDir)%(_GeneratedHelpPublishAsset.Filename)%(_GeneratedHelpPublishAsset.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  </Project>


