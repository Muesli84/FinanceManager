@using FinanceManager.Web.ViewModels.StatementDrafts
@using FinanceManager.Web.ViewModels.Common
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using FinanceManager.Shared.Dtos.Statements
@using System.Linq
@using System.Collections.Generic
@using System.Globalization
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS

@code {
    [Parameter]
    public FinanceManager.Web.ViewModels.Common.BaseListViewModel? ViewModel { get; set; }

    private void OnSubjectChanged(ChangeEventArgs e, Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        vm?.SetEditValue(id, "Subject", e?.Value?.ToString());
    }

    private void OnRecipientChanged(ChangeEventArgs e, Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        vm?.SetEditValue(id, "RecipientName", e?.Value?.ToString());
    }

    private void OnAmountChanged(ChangeEventArgs e, Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        if (decimal.TryParse(e?.Value?.ToString(), out var d))
            vm?.SetEditValue(id, "Amount", d);
        else
            vm?.SetEditValue(id, "Amount", null);
    }

    private async Task OnDateChanged(ChangeEventArgs e, Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        if (vm == null) return;

        var oldValuta = vm.GetEditValue(id, "ValutaDate");
        vm.SetBookingDateFromUi(id, e?.Value?.ToString());
        var newValuta = vm.GetEditValue(id, "ValutaDate");

        if (!object.Equals(oldValuta, newValuta))
        {
            await JS.InvokeVoidAsync("financeManager.quickEdit.applyValues", new[]
            {
                new
                {
                    id = GetElementId(id, "ValutaDate"),
                    value = FormatEditValue(newValuta, "ValutaDate")
                }
            });
        }
    }

    private void ResetRow(Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        vm?.ResetRow(id);
    }

    private void DeleteRow(Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        vm?.MarkRowForDeletion(id);
    }

    private void OnValutaChanged(ChangeEventArgs e, Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        vm?.SetValutaDateFromUi(id, e?.Value?.ToString());
    }

    private async Task OnRowBlur(Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        if (vm == null) return;

        var stillInRow = await JS.InvokeAsync<bool>("financeManager.quickEdit.isFocusInsideRow", $"qe_row_{id}");
        if (!stillInRow)
        {
            vm.ValidateQuickEditRow(id);
        }
    }

    private void OnBookingDescriptionChanged(ChangeEventArgs e, Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        vm?.SetEditValue(id, "BookingDescription", e?.Value?.ToString());
    }

    private async Task ResetDuplicateStatus(Guid id)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        if (vm == null) return;
        // Find item and clear status if it was AlreadyBooked -> set to Open
        var item = vm.Items.FirstOrDefault(i => i.Id == id);
        if (item != null && item.Status == FinanceManager.Shared.Dtos.Statements.StatementDraftEntryStatus.AlreadyBooked)
        {
            item.Status = FinanceManager.Shared.Dtos.Statements.StatementDraftEntryStatus.Open;
            // ensure edit snapshot reflects change so UI updates
            if (vm.IsQuickEditActive)
            {
                vm.SetEditValue(id, "Status", item.Status);
            }
            // Trigger component re-render
            await InvokeAsync(StateHasChanged);

            // If quick-edit is active, focus the first editable field (BookingDate) for this row
            try
            {
                var elId = $"qe_booking_{id}";
                // allow render to complete
                await Task.Yield();
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{elId}')?.focus()");
            }
            catch { }
        }
    }

    private BudgetImpactHintType? GetHighestSeverity(BudgetImpactEvaluationDto? impact)
    {
        if (impact == null || impact.Hints == null || impact.Hints.Count == 0)
        {
            return null;
        }

        return impact.Hints.Max(h => h.HintType);
    }

    private string? GetBudgetTooltip(BudgetImpactEvaluationDto? impact)
    {
        if (impact == null || impact.Hints == null || impact.Hints.Count == 0)
        {
            return null;
        }

        var highest = impact.Hints.OrderByDescending(h => h.HintType).FirstOrDefault();
        if (highest == null)
        {
            return null;
        }

        var localizedReason = GetLocalizedMessage(highest.Reason);
        return $"{highest.BudgetPurposeName} ({highest.BudgetPeriod}): {localizedReason}";
    }

    private string GetLocalizedMessage(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return message;
        }

        // Check if the message contains a pipe separator (indicating translation key with parameters)
        if (message.Contains('|'))
        {
            var parts = message.Split('|');
            var key = parts[0];
            var parameters = parts.Skip(1).ToArray();

            // Try to get the localized string (need to get localizer from service provider)
            var localizer = ServiceProvider.GetService<Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages>>();
            var localizedString = localizer?[key];
            if (localizedString != null && !localizedString.ResourceNotFound)
            {
                // Format the message with parameters
                try
                {
                    var formattedParams = new List<object>();
                    foreach (var p in parameters)
                    {
                        formattedParams.Add(p);
                    }
                    
                    return string.Format(localizedString, formattedParams.ToArray());
                }
                catch (FormatException)
                {
                    // If formatting fails, return the key as fallback
                    return message;
                }
            }
        }
        
        // If no translation key format or translation not found, return the original message
        return message;
    }

    private async Task OnKeyDown(KeyboardEventArgs e, Guid id, string field)
    {
        var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
        if (e.CtrlKey && (e.Key == "ArrowUp" || e.Key == "ArrowDown"))
        {
            if (vm != null)
            {
                await FocusAdjacentQuickEditFieldAsync(vm, id, field, e.Key == "ArrowUp" ? -1 : 1);
            }

            return;
        }

        if (e.Key != "F8" || vm == null) return;

        if (e.CtrlKey)
        {
            vm.TakeAllValuesFromAbove(id);
            var values = new List<object>();
            foreach (var f in vm.EditableFields)
            {
                values.Add(new
                {
                    id = GetElementId(id, f),
                    value = FormatEditValue(vm.GetEditValue(id, f), f)
                });
            }
            await JS.InvokeVoidAsync("financeManager.quickEdit.applyValues", values);
        }
        else
        {
            vm.TakeValueFromAbove(id, field);
            await JS.InvokeVoidAsync("financeManager.quickEdit.applyValues", new[]
            {
                new
                {
                    id = GetElementId(id, field),
                    value = FormatEditValue(vm.GetEditValue(id, field), field)
                }
            });
        }
    }

    private async Task FocusAdjacentQuickEditFieldAsync(
        FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel vm,
        Guid id,
        string field,
        int offset)
    {
        var visibleItems = vm.VisibleQuickEditItems;
        var currentIndex = -1;
        for (var i = 0; i < visibleItems.Count; i++)
        {
            if (visibleItems[i].Id == id)
            {
                currentIndex = i;
                break;
            }
        }

        if (currentIndex < 0)
        {
            return;
        }

        for (var targetIndex = currentIndex + offset;
             targetIndex >= 0 && targetIndex < visibleItems.Count;
             targetIndex += offset)
        {
            var target = visibleItems[targetIndex];
            if (!vm.IsRowEditable(target))
            {
                continue;
            }

            var targetElementId = GetElementId(target.Id, field);
            if (string.IsNullOrWhiteSpace(targetElementId))
            {
                return;
            }

            await JS.InvokeVoidAsync("financeManager.quickEdit.focusById", targetElementId);
            return;
        }
    }

    private string GetElementId(Guid id, string field) => field switch
    {
        "BookingDate" => $"qe_booking_{id}",
        "ValutaDate" => $"qe_valuta_{id}",
        "Amount" => $"qe_amount_{id}",
        "BookingDescription" => $"qe_description_{id}",
        "RecipientName" => $"qe_recipient_{id}",
        "Subject" => $"qe_subject_{id}",
        _ => string.Empty
    };

    private string FormatEditValue(object? value, string field)
    {
        if (value == null) return string.Empty;
        if ((field == "BookingDate" || field == "ValutaDate") && value is DateTime dt)
            return dt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if (value is decimal dec)
            return dec.ToString(CultureInfo.CurrentCulture);
        return value.ToString() ?? string.Empty;
    }
}

@{
    var vm = ViewModel as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel;
    var records = vm?.Records ?? new List<FinanceManager.Web.ViewModels.Common.ListRecord>();
    Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages>? localizer = null;
    try { localizer = ServiceProvider.GetService<Microsoft.Extensions.Localization.IStringLocalizer<FinanceManager.Web.Pages>>(); } catch { }
    // If the ViewModel requested focusing first invalid row, consume the id and focus client-side
    var focusId = (vm as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel)?.ConsumeFocusFirstInvalid();
    if (focusId != null)
    {
        try
        {
            _ = JS.InvokeVoidAsync("eval", $"document.getElementById('qe_booking_{focusId}')?.focus()");
        }
        catch { }
    }
}

@if (vm == null)
{
    <div class="text-muted">@(localizer?["General_NoData"].Value ?? "No data")</div>
}
else
{
    var hasPixelWidths = vm.Columns?.Any(c => !string.IsNullOrWhiteSpace(c.Width) && c.Width.Trim().EndsWith("px", StringComparison.OrdinalIgnoreCase)) ?? false;
    <table class="fm-table wide @(hasPixelWidths ? "fixed-layout" : null)">
        <thead>
            <tr>
                @{
                    // Helper to get title/width from vm.Columns by index with fallback
                    string GetTitle(int idx, string fallback)
                    {
                        if (vm.Columns != null && vm.Columns.Count > idx)
                            return vm.Columns[idx].Title ?? fallback;
                        return fallback;
                    }
                    var dateTitle = GetTitle(1, localizer != null ? (localizer["List_Th_Date"].Value ?? "Date") : "Date");
                    var amountTitle = GetTitle(2, localizer != null ? (localizer["List_Th_Amount"].Value ?? "Amount") : "Amount");
                    var recipientTitle = GetTitle(3, localizer != null ? (localizer["List_Th_Recipient"].Value ?? "Recipient") : "Recipient");
                    var subjectTitle = GetTitle(4, localizer != null ? (localizer["List_Th_Subject"].Value ?? "Subject") : "Subject");
                    var statusTitle = GetTitle(7, localizer != null ? (localizer["List_Th_Status"].Value ?? "Status") : "Status");
                }
                @* Headers aligned with quick-edit columns: BookingDate, Valuta, Amount, BookingDescription, Recipient, Purpose, Actions *@
                <th>@(localizer != null ? localizer["List_Th_BookingDate"].Value : "Booking date")</th>
                <th>@(localizer != null ? localizer["List_Th_Valuta"].Value : "Valuta")</th>
                <th style="text-align:right;">@(localizer != null ? localizer["List_Th_Amount"].Value : "Amount")</th>
                <th>@(localizer != null ? localizer["List_Th_BookingDescription"].Value : "Booking description")</th>
                <th>@(localizer != null ? localizer["List_Th_Recipient"].Value : "Recipient")</th>
                <th>@(localizer != null ? localizer["List_Th_Purpose"].Value : "Purpose")</th>
                <th>@(localizer != null ? localizer["List_Th_Status"].Value : "Status")</th>
                <th style="width:6rem">@(localizer != null ? (localizer["List_Th_Actions"].ResourceNotFound ? "Actions" : localizer["List_Th_Actions"].Value) : "Actions")</th>
            </tr>
        </thead>
        <tbody>
            @{
                var renderedCols = 8; // BookingDate, Valuta, Amount, BookingDescription, Recipient, Purpose, Status, Actions
                var visibleItems = vm.IsQuickEditActive ? vm.VisibleQuickEditItems : vm.Items;
            }
            @for (int idx = 0; idx < visibleItems.Count; idx++)
            {
                var item = visibleItems[idx];
                var rec = records.FirstOrDefault(r => (r.Item as FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntryItem)?.Id == item.Id);
                var editable = vm.IsRowEditable(item);
                var isMuted = item.Status == FinanceManager.Shared.Dtos.Statements.StatementDraftEntryStatus.AlreadyBooked;
                var rowStyle = isMuted ? "cursor:pointer;opacity:.6;" : "cursor:pointer;";
                var rowClass = item.IsPlaceholder ? "quick-edit-placeholder-row" : isMuted ? "muted-row" : item.IsNew ? "quick-edit-new-row" : null;

                <tr id="qe_row_@item.Id" @key="item.Id" class="@rowClass" style="@rowStyle">
                    @* Booking date *@
                    <td style="text-align:left;vertical-align:middle;">
                        @if (rec != null && !string.IsNullOrWhiteSpace(rec.Hint))
                        {
                            <span style="color:#ffc107;margin-right:.25rem;font-weight:bold;cursor:help;" title="@rec.Hint">!</span>
                        }
                        @if (editable)
                        {
                            var bdVal = vm.GetEditValue(item.Id, "BookingDate");
                            DateTime? bd = null;
                            if (bdVal is DateTime bdt) bd = bdt;
                            else if (bdVal != null && DateTime.TryParse(bdVal.ToString(), out var pb)) bd = pb;
                            var bdInput = bd.HasValue ? bd.Value.ToString("yyyy-MM-dd") : string.Empty;
                            <input id="qe_booking_@item.Id" type="date" class="form-control form-control-sm" data-fm-quickedit-keepalive value="@bdInput" @onchange="@(e => OnDateChanged(e, item.Id))" @onblur="async (e) => await OnRowBlur(item.Id)" @onkeydown='(e) => OnKeyDown(e, item.Id, "BookingDate")' />
                        }
                        else
                        {
                            <span>@item.BookingDate.ToString("d")</span>
                        }
                    </td>

                    @* Valuta (value date) *@
                    <td style="text-align:left;vertical-align:middle;">
                        @if (editable)
                        {
                            var editVal = vm.GetEditValue(item.Id, "ValutaDate");
                            DateTime? valDate = item.ValutaDate;
                            if (editVal != null)
                            {
                                // try unbox or parse
                                if (editVal is DateTime d) valDate = d;
                                else if (DateTime.TryParse(editVal.ToString(), out var pd)) valDate = pd;
                            }

                            string inputVal = valDate.HasValue ? valDate.Value.ToString("yyyy-MM-dd") : string.Empty;
                            <input id="qe_valuta_@item.Id" type="date" class="form-control form-control-sm" data-fm-quickedit-keepalive value="@inputVal" @onchange="@(e => OnValutaChanged(e, item.Id))" @onblur="async (e) => await OnRowBlur(item.Id)" @onkeydown='(e) => OnKeyDown(e, item.Id, "ValutaDate")' />
                        }
                        else
                        {
                            <span>@(item.ValutaDate.HasValue ? item.ValutaDate.Value.ToString("d") : string.Empty)</span>
                        }
                    </td>

                    @* Amount *@
                    <td style="text-align:right;vertical-align:middle;">
                        @if (editable)
                        {
                            <input id="qe_amount_@item.Id" class="form-control form-control-sm text-end" data-fm-quickedit-keepalive value="@((vm.GetEditValue(item.Id, "Amount") as decimal?)?.ToString())" @oninput="(e) => OnAmountChanged(e, item.Id)" @onblur="async (e) => await OnRowBlur(item.Id)" @onkeydown='(e) => OnKeyDown(e, item.Id, "Amount")' />
                        }
                        else
                        {
                            <span>@item.Amount.ToString("C")</span>
                        }
                    </td>

                    @* Booking description *@
                    <td style="vertical-align:middle;">
                        @if (editable)
                        {
                            <input id="qe_description_@item.Id" class="form-control form-control-sm" data-fm-quickedit-keepalive value='@(vm.GetEditValue(item.Id, "BookingDescription") as string ?? item.BookingDescription ?? string.Empty)' @oninput="@(e => OnBookingDescriptionChanged(e, item.Id))" @onblur="async (e) => await OnRowBlur(item.Id)" @onkeydown='(e) => OnKeyDown(e, item.Id, "BookingDescription")' />
                        }
                        else
                        {
                            <span>@(item.BookingDescription ?? string.Empty)</span>
                        }
                    </td>

                    @* Recipient *@
                    <td style="vertical-align:middle;">
                        @if (editable)
                        {
                            <input id="qe_recipient_@item.Id" class="form-control form-control-sm" data-fm-quickedit-keepalive value='@(vm.GetEditValue(item.Id, "RecipientName") as string ?? item.RecipientName ?? string.Empty)' placeholder='@(vm.RecipientPlaceholder ?? string.Empty)' @oninput="(e) => OnRecipientChanged(e, item.Id)" @onblur="async (e) => await OnRowBlur(item.Id)" @onkeydown='(e) => OnKeyDown(e, item.Id, "RecipientName")' />
                        }
                        else
                        {
                            <span>@(string.IsNullOrWhiteSpace(item.RecipientName) ? string.Empty : item.RecipientName)</span>
                        }
                    </td>

                    @* Purpose / Subject (Verwendungszweck) *@
                    <td style="vertical-align:middle;">
                        @if (editable)
                        {
                            <input id="qe_subject_@item.Id" class="form-control form-control-sm" data-fm-quickedit-keepalive value='@(vm.GetEditValue(item.Id, "Subject") as string ?? item.Subject ?? string.Empty)' @oninput="(e) => OnSubjectChanged(e, item.Id)" @onblur="async (e) => await OnRowBlur(item.Id)" @onkeydown='(e) => OnKeyDown(e, item.Id, "Subject")' />
                        }
                        else
                        {
                            <span>@(string.IsNullOrWhiteSpace(item.Subject) ? string.Empty : item.Subject)</span>
                            @if (GetHighestSeverity(item.BudgetImpact) is BudgetImpactHintType budgetSeverity)
                            {
                                var budgetIconName = budgetSeverity switch
                                {
                                    BudgetImpactHintType.Exceeded => "alert-circle",
                                    BudgetImpactHintType.AlmostExhausted => "alert-triangle",
                                    BudgetImpactHintType.StronglyChanged => "info",
                                    _ => "info"
                                };
                                var budgetColorStyle = budgetSeverity switch
                                {
                                    BudgetImpactHintType.Exceeded => "color:var(--error-color,#c0392b);",
                                    BudgetImpactHintType.AlmostExhausted => "color:var(--warning-color,#f39c12);",
                                    BudgetImpactHintType.StronglyChanged => "color:var(--info-color,#3498db);",
                                    _ => ""
                                };
                                <span class="budget-impact-badge" style="display:inline-flex;vertical-align:middle;margin-left:.25rem;@budgetColorStyle" title="@GetBudgetTooltip(item.BudgetImpact)">
                                    <svg style="width:1rem;height:1rem;" aria-hidden="true"><use href="/icons/sprite.svg#@budgetIconName" /></svg>
                                </span>
                            }
                        }
                    </td>

                    <td style="vertical-align:middle;">
                        <span>@item.Status.ToString()</span>
                    </td>

                    <td style="vertical-align:middle;display:flex;gap:.25rem;align-items:center;">
                        @if (editable && !item.IsPlaceholder)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => ResetRow(item.Id)" @onblur="async (e) => await OnRowBlur(item.Id)">@(localizer != null ? localizer["Ribbon_Reset"].Value : "Reset")</button>
                        }
                        @if (vm.CanDeleteRow(item))
                        {
                            var deleteLabel = localizer != null ? (localizer["QuickEdit_DeleteRow"].ResourceNotFound ? "Delete row" : localizer["QuickEdit_DeleteRow"].Value) : "Delete row";
                            <button type="button" class="quick-edit-delete-button" title="@deleteLabel" aria-label="@deleteLabel" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => DeleteRow(item.Id)" @onblur="async (e) => await OnRowBlur(item.Id)">
                                <svg aria-hidden="true"><use href="/icons/sprite.svg#delete"></use></svg>
                            </button>
                        }
                        @* Show Reset Dup only for items marked as AlreadyBooked (duplicate) *@
                        @if (isMuted)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="@(localizer != null ? localizer["Ribbon_ResetDuplicate"].Value : "Reset duplicate status")" style="pointer-events:auto;" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="@(() => ResetDuplicateStatus(item.Id))" @onpointerdown="@(() => ResetDuplicateStatus(item.Id))" @onblur="async (e) => await OnRowBlur(item.Id)">@(localizer != null ? localizer["Ribbon_ResetDuplicate"].Value : "Reset Dup")</button>
                        }
                    </td>
                </tr>

                @if (rec != null && !string.IsNullOrWhiteSpace(rec.Hint))
                {
                    <tr>
                        <td colspan="@renderedCols" style="padding:.25rem .6rem .75rem .6rem;color:var(--muted);font-size:.9rem;">@((localizer != null) ? (localizer[rec.Hint] ?? rec.Hint) : rec.Hint)</td>
                    </tr>
                }
            }

            @if (vm.Loading)
            {
                <tr><td colspan="99" style="opacity:.6;">@("Loading...")</td></tr>
            }
        </tbody>
    </table>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ViewModel is FinanceManager.Web.ViewModels.StatementDrafts.StatementDraftEntriesListViewModel vm)
        {
            var focusId = vm.ConsumeFocusQuickEditBookingDate();
            if (focusId.HasValue)
            {
                try
                {
                    await Task.Yield();
                    await JS.InvokeVoidAsync("eval", $"document.getElementById('qe_booking_{focusId}')?.focus()");
                }
                catch { }
            }
        }
    }
}
