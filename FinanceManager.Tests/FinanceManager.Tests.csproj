    <ProjectReference Include="..\FinanceManager.Domain\FinanceManager.Domain.csproj" />
    <ProjectReference Include="..\FinanceManager.Web\FinanceManager.Web.csproj" />
    <ProjectReference Include="..\FinanceManager.Shared\FinanceManager.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\tools\FinanceManager.HelpSearchIndexGenerator\HelpSearchIndexGeneratorRunner.cs" Link="Tools\HelpSearchIndexGeneratorRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
